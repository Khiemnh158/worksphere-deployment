{
  "uid": "worksphere-api",
  "title": "WorkSphere API",
  "tags": ["worksphere", "coursework"],
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API scrape availability",
      "description": "Prometheus could scrape the API when the value is 1.",
      "datasource": {"uid": "worksphere-prometheus", "type": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [{"refId": "A", "expr": "up{job=\"worksphere-api\"}", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate by status",
      "datasource": {"uid": "worksphere-prometheus", "type": "prometheus"},
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 6},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"worksphere-api\",uri!~\"/actuator/.*\"}[$__rate_interval]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP error rate",
      "datasource": {"uid": "worksphere-prometheus", "type": "prometheus"},
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"worksphere-api\",status=~\"4..\"}[$__rate_interval]))", "legendFormat": "4xx"},
        {"refId": "B", "expr": "sum(rate(http_server_requests_seconds_count{job=\"worksphere-api\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP latency p95",
      "datasource": {"uid": "worksphere-prometheus", "type": "prometheus"},
      "gridPos": {"x": 8, "y": 6, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"worksphere-api\",uri!~\"/actuator/.*\"}[$__rate_interval])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM memory used",
      "datasource": {"uid": "worksphere-prometheus", "type": "prometheus"},
      "gridPos": {"x": 16, "y": 6, "w": 8, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by (area) (jvm_memory_used_bytes{job=\"worksphere-api\"})", "legendFormat": "{{area}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    }
  ]
}
